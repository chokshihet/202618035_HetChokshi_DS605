   "source": [
    "\n",
    "missing_df = pd.DataFrame({\n",
    "    'Missing Count': df.isnull().sum(),\n",
    "    'Missing Percentage (%)': (df.isnull().sum() / len(df)) * 100\n",
    "})\n",
    "print(\"--- Missing Values Summary ---\")\n",
    "print(missing_df[missing_df['Missing Count'] > 0])\n",
    "\n",
    "plt.figure(figsize=(8, 4))\n",
    "missing_counts = df.isnull().sum()\n",
    "missing_counts[missing_counts > 0].plot(kind='bar', color='crimson', edgecolor='black', alpha=0.8)\n",
    "plt.title(\"Missing Value Counts per Column\", fontsize=12)\n",
    "plt.xlabel(\"Columns\")\n",
    "plt.ylabel(\"Missing Count\")\n",
    "plt.xticks(rotation=0)\n",
    "plt.grid(axis='y', linestyle='--', alpha=0.6)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"\\n--- Fill Missing Age with Mean ---\")\n",
    "print(f\"Missing Age count BEFORE: {df['Age'].isnull().sum()}\")\n",
    "\n",
    "df_age_filled = df['Age'].fillna(df['Age'].mean())\n",
    "print(f\"Missing Age count AFTER : {df_age_filled.isnull().sum()}\")\n",
    "\n",
    "\n",
    "print(\"\\n--- Imputation Method Examples (Age Column) ---\")\n",
    "\n",
    "\n",
    "age_mean = df['Age'].fillna(df['Age'].mean())\n",
    "print(f\"Mean Imputation - Filled Value: {df['Age'].mean():.2f}\")\n",
    "\n",
    "\n",
    "age_median = df['Age'].fillna(df['Age'].median())\n",
    "print(f\"Median Imputation - Filled Value: {df['Age'].median():.2f}\")\n",
    "\n",
    "\n",
    "age_mode = df['Age'].fillna(df['Age'].mode()[0])\n",
    "print(f\"Mode Imputation - Filled Value: {df['Age'].mode()[0]:.2f}\")\n",
    "\n",
    "\n",
    "np.random.seed(42)\n",
    "non_null_ages = df['Age'].dropna()\n",
    "random_fill = df['Age'].apply(lambda x: np.random.choice(non_null_ages) if pd.isnull(x) else x)\n",
    "print(f\"Random Value Imputation completed for {df['Age'].isnull().sum()} missing entries.\")\n",
    "\n",
    "\n",
    "print(\"\\n--- Fare Outlier Analysis (IQR Method) ---\")\n",
    "Q1 = df['Fare'].quantile(0.25)\n",
    "Q3 = df['Fare'].quantile(0.75)\n",
    "IQR = Q3 - Q1\n",
    "\n",
    "lower_bound = Q1 - 1.5 * IQR\n",
    "upper_bound = Q3 + 1.5 * IQR\n",
    "\n",
    "outliers = df[(df['Fare'] < lower_bound) | (df['Fare'] > upper_bound)]\n",
    "\n",
    "print(f\"Q1 (25th percentile): {Q1:.2f}\")\n",
    "print(f\"Q3 (75th percentile): {Q3:.2f}\")\n",
    "print(f\"IQR                 : {IQR:.2f}\")\n",
    "print(f\"Lower Bound         : {lower_bound:.2f}\")\n",
    "print(f\"Upper Bound         : {upper_bound:.2f}\")\n",
    "print(f\"Total Fare Outliers : {len(outliers)} (out of {len(df)} total passengers)\")"
   ]
  },
