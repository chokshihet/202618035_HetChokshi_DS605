   ],
   "source": [
    "df['FamilySize'] = df['SibSp'] + df['Parch'] + 1\n",
    "df['IsAlone'] = (df['FamilySize'] == 1).astype(int)\n",
    "\n",
    "print(\"--- Feature Engineering Sample ---\")\n",
    "print(df[['SibSp', 'Parch', 'FamilySize', 'IsAlone']].head())\n",
    "\n",
    "\n",
    "pivot_survival = df.pivot_table(\n",
    "    index='Sex', \n",
    "    columns='Pclass', \n",
    "    values='Survived', \n",
    "    aggfunc='mean'\n",
    ")\n",
    "\n",
    "print(\"\\n--- Survival Rate Pivot Table (Sex vs Pclass) ---\")\n",
    "print(pivot_survival)\n",
    "\n",
    "\n",
    "unstacked_pivot = pivot_survival.unstack()\n",
    "highest_group = unstacked_pivot.idxmax()  \n",
    "highest_val = unstacked_pivot.max()\n",
    "\n",
    "lowest_group = unstacked_pivot.idxmin()   \n",
    "lowest_val = unstacked_pivot.min()\n",
    "\n",
    "print(\"\\n--- Group Analysis ---\")\n",
    "print(f\"Highest Survival Group: Pclass {highest_group[0]}, {highest_group[1].title()} ({highest_val*100:.2f}%)\")\n",
    "print(f\"Lowest Survival Group : Pclass {lowest_group[0]}, {lowest_group[1].title()} ({lowest_val*100:.2f}%)\")"
   ]
  },
