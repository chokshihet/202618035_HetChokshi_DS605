    "import seaborn as sns\n",
    "\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "\n",
    "\n",
    "df = pd.read_csv('train.csv')\n",
    "df['FamilySize'] = df['SibSp'] + df['Parch'] + 1\n",
    "df['IsAlone'] = (df['FamilySize'] == 1).astype(int)\n",
    "\n",
    "\n",
    "plt.figure(figsize=(10, 7))\n",
    "\n",
    "\n",
    "numerical_cols = ['Survived', 'Pclass', 'Age', 'SibSp', 'Parch', 'Fare', 'FamilySize', 'IsAlone']\n",
    "corr_matrix = df[numerical_cols].corr()\n",
    "\n",
    "\n",
    "sns.heatmap(\n",
    "    corr_matrix, \n",
    "    annot=True, \n",
    "    fmt=\".2f\", \n",
    "    cmap=\"coolwarm\", \n",
    "    vmin=-1, \n",
    "    vmax=1, \n",
    "    linewidths=0.5\n",
    ")\n",
    "plt.title(\"Correlation Heatmap of Titanic Numerical Features\", fontsize=14, pad=12)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "\n",
    "sex_stats = df.groupby('Sex')['Survived'].agg(\n",
    "    Survival_Rate='mean',\n",
    "    Total_Count='count'\n",
    ").reset_index()\n",
    "\n",
    "female_rate = sex_stats.loc[sex_stats['Sex'] == 'female', 'Survival_Rate'].values[0] * 100\n",
    "male_rate = sex_stats.loc[sex_stats['Sex'] == 'male', 'Survival_Rate'].values[0] * 100\n",
    "\n",
    "print(f\"--- Survival Rates by Sex ---\")\n",
    "print(f\"Female Survival Rate: {female_rate:.2f}%\")\n",
    "print(f\"Male Survival Rate  : {male_rate:.2f}%\\n\")\n",
    "\n",
    "plt.figure(figsize=(6, 5))\n",
    "ax = sns.barplot(\n",
    "    data=sex_stats, \n",
    "    x='Sex', \n",
    "    y=sex_stats['Survival_Rate'] * 100, \n",
    "    palette=['pink', 'skyblue'], \n",
    "    edgecolor='black'\n",
    ")\n",
    "\n",
    "plt.title(\"Survival Rate by Sex\", fontsize=14)\n",
    "plt.ylabel(\"Survival Rate (%)\")\n",
    "plt.xlabel(\"Sex\")\n",
    "plt.ylim(0, 100)\n",
    "\n",
    "\n",
    "for p in ax.patches:\n",
    "    height = p.get_height()\n",
    "    ax.annotate(\n",
    "        f'{height:.2f}%',\n",
    "        (p.get_x() + p.get_width() / 2., height),\n",
    "        ha='center', va='bottom',\n",
    "        xytext=(0, 5),\n",
    "        textcoords='offset points',\n",
    "        fontweight='bold'\n",
    "    )\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "\n",
    "sns.scatterplot(\n",
    "    data=df, \n",
    "    x='Age', \n",
    "    y='Fare', \n",
    "    hue='Survived', \n",
    "    palette={0: 'crimson', 1: 'forestgreen'},\n",
    "    alpha=0.7, \n",
    "    s=60,\n",
    "    style='Survived',\n",
    ")\n",
    "\n",
    "plt.title(\"Age vs Fare (Distinguishing Survival Status)\", fontsize=14)\n",
    "plt.xlabel(\"Age (Years)\")\n",
    "plt.ylabel(\"Fare (£)\")\n",
