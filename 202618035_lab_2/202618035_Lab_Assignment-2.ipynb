   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "--- Matrix Operations ---\n",
      "Addition (M1 + M2):\n",
      "[[ 5  9  5]\n",
      " [ 3 10  6]\n",
      " [ 3  5 14]]\n",
      "\n",
      "Element-wise Multiplication (M1 * M2):\n",
      "[[ 4 14  6]\n",
      " [ 0 24  5]\n",
      " [ 2  0 48]]\n",
      "\n",
      "Matrix Multiplication (M1 @ M2):\n",
      "[[ 6 36 59]\n",
      " [ 4 30 45]\n",
      " [10 24 79]]\n",
      "\n",
      "Matrix Properties: \n",
      "Transpose of M1:\n",
      "[[4 3 2]\n",
      " [7 6 5]\n",
      " [2 1 8]]\n",
      "Determinant of M1: 24.0000\n",
      "\n",
      "--- Matrix Inverse & Verification ---\n",
      "M1 Inverse:\n",
      "[[ 1.79166667 -1.91666667 -0.20833333]\n",
      " [-0.91666667  1.16666667  0.08333333]\n",
      " [ 0.125      -0.25        0.125     ]]\n",
      "\n",
      "M1 @ M1^-1:\n",
      "[[ 1. -0.  0.]\n",
      " [ 0.  1. -0.]\n",
      " [ 0. -0.  1.]]\n",
      "Is M1 @ M1^-1 equal to Identity Matrix? True\n"
     ]
    }
   ],
   "source": [
    "M1 = np.array([[4,7,2],\n",
    "               [3,6,1],\n",
    "               [2,5,8]])\n",
    "\n",
    "M2 = np.array([[1,2,3],\n",
    "               [0,4,5],\n",
    "               [1,0,6]])\n",
    "\n",
    "addition = M1 + M2\n",
    "elem_mult = M1 * M2\n",
    "matmul = M1 @ M2\n",
    "\n",
    "print(\"--- Matrix Operations ---\")\n",
    "print(f\"Addition (M1 + M2):\\n{addition}\\n\")\n",
    "print(f\"Element-wise Multiplication (M1 * M2):\\n{elem_mult}\\n\")\n",
    "print(f\"Matrix Multiplication (M1 @ M2):\\n{matmul}\\n\")\n",
    "\n",
    "M1_transpose = M1.T\n",
    "det_M1 = np.linalg.det(M1)\n",
    "\n",
    "print(\"Matrix Properties: \")\n",
    "print(f\"Transpose of M1:\\n{M1_transpose}\")\n",
    "print(f\"Determinant of M1: {det_M1:.4f}\\n\")\n",
    "\n",
    "if not np.isclose(det_M1, 0):\n",
    "    M1_inv = np.linalg.inv(M1)\n",
    "    identity_calc = M1 @ M1_inv\n",
    "    \n",
    "    # Verify M1 @ M1_inv is approximately Identity Matrix I\n",
    "    is_identity = np.allclose(identity_calc, np.eye(3))\n",
    "    \n",
    "    print(\"--- Matrix Inverse & Verification ---\")\n",
    "    print(f\"M1 Inverse:\\n{M1_inv}\\n\")\n",
    "    print(f\"M1 @ M1^-1:\\n{np.round(identity_calc, 4)}\")\n",
    "    print(f\"Is M1 @ M1^-1 equal to Identity Matrix? {is_identity}\")\n",
    "else:\n",
    "    print(\"Matrix is singular and non-invertible.\")"
   ]
  },
