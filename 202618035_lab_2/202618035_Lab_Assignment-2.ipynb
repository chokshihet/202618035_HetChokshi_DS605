    "import matplotlib.pyplot as plt\n",
    "\n",
    "chosen_mean = 50\n",
    "chosen_std = 10\n",
    "num_samples = 1000\n",
    "\n",
    "data = np.random.normal(loc=chosen_mean, scale=chosen_std, size=num_samples)\n",
    "\n",
    "sample_mean = np.mean(data)\n",
    "sample_std = np.std(data)\n",
    "\n",
    "print(\"Distribution Parameters: \")\n",
    "print(f\"Chosen mean: {chosen_mean} | sample mean: {sample_mean:.4f}\")\n",
    "print(f\"Chosen std: {chosen_std} | Sample std: {sample_std:.4f}\")\n",
    "\n",
    "plt.figure(figsize=(8,5))\n",
    "plt.hist(data, bins=35, edgecolor='blue', color='steelblue', alpha=0.7, density=True)\n",
    "\n",
    "plt.axvline(chosen_mean, color='red', linestyle='--', linewidth=2, label=f'Chosen Mean ({chosen_mean})')\n",
    "plt.axvline(sample_mean, color='orange', linestyle=':', linewidth=2, label=f'Sample Mean ({sample_mean:.2f})')\n",
    "\n",
    "plt.title(\"Normal Distribution Sample Histogram\", fontsize=14)\n",
    "plt.xlabel(\"Value\", fontsize=12)\n",
    "plt.ylabel(\"Probability Density\", fontsize=12)\n",
    "plt.legend()\n",
    "plt.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
